<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>后台仪表盘</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{display:flex;font-family:system-ui;background:#f4f6f8}
aside{width:220px;background:#1f2937;color:#fff;height:100vh;padding-top:20px}
aside h3{text-align:center;margin-bottom:30px;color:#eee}
aside a{display:block;color:#cbd5e1;padding:12px 24px;text-decoration:none;font-size:15px}
aside a:hover{background:#374151}
.main{flex:1;padding:30px}
.top-bar{display:flex;justify-content:space-between;margin-bottom:30px}
.top-bar a{color:#dc2626;text-decoration:none}
.card-wrap{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.card{background:#fff;padding:24px;border-radius:8px;box-shadow:0 1px 3px #00000015}
.card h4{font-size:14px;color:#666;margin-bottom:8px}
.card .num{font-size:28px;font-weight:bold;color:#111}
</style>
</head>
<body>
<aside>
  <h3>管理后台</h3>
  <a href="/admin">仪表盘</a>
  <a href="#">产品管理（待开发）</a>
  <a href="#">分类管理（待开发）</a>
  <a href="#">询盘管理（待开发）</a>
  <a href="#">网站设置（待开发）</a>
  <a href="#">轮播&背景（待开发）</a>
  <a href="/admin/logout">退出登录</a>
</aside>
<div class="main">
  <div class="top-bar">
    <h2>仪表盘</h2>
    <a href="/admin/logout">退出</a>
  </div>
  <div class="card-wrap">
    <div class="card">
      <h4>产品总数</h4>
      <div class="num"><%= productTotal %></div>
    </div>
    <div class="card">
      <h4>询盘总数</h4>
      <div class="num"><%= inquiryTotal %></div>
    </div>
  </div>
</div>
</body>
</html>
