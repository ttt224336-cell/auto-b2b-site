<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>系统设置 — AutoParts B2B</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--main:#0A2F5F;--blue:#1E6BD9;--accent:#F59E0B;--light:#F3F4F6;--gray:#E5E7EB;--r:12px;--green:#10B981;}
    *{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif;}
    body{background:var(--light);display:flex;min-height:100vh;color:#1F2937;}
    .sidebar{width:220px;background:var(--main);color:#fff;position:fixed;top:0;bottom:0;left:0;display:flex;flex-direction:column;z-index:50;}
    .s-top{padding:22px 18px;border-bottom:1px solid rgba(255,255,255,.1);}
    .s-top h2{font-size:17px;font-weight:700;}
    .s-top p{font-size:12px;opacity:.7;margin-top:4px;}
    .s-menu{padding:16px 0;flex:1;overflow-y:auto;}
    .s-menu a{display:block;padding:11px 20px;margin:3px 10px;border-radius:8px;color:rgba(255,255,255,.85);font-size:14px;text-decoration:none;transition:.15s;}
    .s-menu a:hover,.s-menu a.active{background:var(--blue);color:#fff;}
    .s-bot{padding:16px;border-top:1px solid rgba(255,255,255,.1);}
    .s-bot a{color:#FCA5A5;font-size:13px;text-decoration:none;}
    .main{flex:1;margin-left:220px;padding:24px;}
    @media(max-width:900px){.main{margin-left:0;padding:16px;}.sidebar{display:none;}}
    .top-bar{background:#fff;padding:16px 22px;border-radius:var(--r);margin-bottom:22px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 1px 6px rgba(0,0,0,.04);flex-wrap:wrap;gap:12px;}
    .top-bar h1{font-size:18px;font-weight:600;color:var(--main);}
    .btn{display:inline-flex;align-items:center;gap:6px;padding:10px 18px;border-radius:8px;border:none;cursor:pointer;font-size:13px;font-weight:500;text-decoration:none;transition:.2s;}
    .btn-blue{background:var(--blue);color:#fff;}
    .btn-blue:hover{background:#1858b8;transform:translateY(-1px);}
    .btn-green{background:var(--green);color:#fff;}
    .btn-green:hover{background:#059669;}
    .btn-outline{background:#fff;border:1px solid var(--gray);color:#374151;}
    .card{background:#fff;border-radius:var(--r);padding:24px;margin-bottom:20px;box-shadow:0 1px 6px rgba(0,0,0,.04);}
    .card h3{font-size:15px;font-weight:600;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--gray);color:var(--main);}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;}
    label{display:block;font-size:12px;font-weight:500;color:#4B5563;margin-bottom:5px;}
    input,select,textarea{width:100%;padding:10px 12px;border:1px solid #D1D5DB;border-radius:8px;font-size:13px;margin-bottom:10px;outline:none;transition:.15s;}
    input:focus,select:focus,textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(30,107,217,.12);}
    .hint{font-size:12px;color:#6B7280;margin-bottom:8px;}
    .success{background:#ECFDF5;color:#065F46;padding:12px 16px;border-radius:8px;margin-bottom:16px;border:1px solid #A7F3D0;}
    .rate-box{background:#F8FAFC;border:1px solid var(--gray);border-radius:10px;padding:16px;margin-top:12px;}
    .rate-row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:10px;}
    .rate-item{background:#fff;border:1px solid var(--gray);border-radius:8px;padding:10px 14px;min-width:120px;text-align:center;}
    .rate-item strong{display:block;font-size:18px;color:var(--main);}
    .rate-item span{font-size:12px;color:#6B7280;}
    .img-preview{max-width:160px;max-height:80px;border-radius:6px;margin-top:6px;border:1px solid #eee;object-fit:cover;}
    .file-row{display:flex;gap:10px;align-items:flex-start;flex-wrap:wrap;}
    .file-row input[type=text]{flex:1;min-width:180px;}
  </style>
</head>
<body>
  <div class="sidebar">
    <div class="s-top"><h2>汽配B2B管理</h2><p>Admin Panel v2</p></div>
    <nav class="s-menu">
      <a href="/admin/product">📦 产品管理</a>
      <a href="/admin/category">📁 分类管理</a>
      <a href="/admin/factory">🏭 工厂展示</a>
      <a href="/admin/inquiry">📩 询盘管理</a>
      <a href="/admin/datapack">📥 数据包</a>
      <a href="/admin/settings" class="active">⚙️ 系统设置</a>
      <a href="/admin/stats">📈 数据统计</a>
    </nav>
    <div class="s-bot"><a href="/admin/logout">🚪 退出登录</a></div>
  </div>
  <div class="main">
    <div class="top-bar">
      <h1>⚙️ 系统设置</h1>
      <a href="/" target="_blank" class="btn btn-outline">🌐 查看前台</a>
    </div>
    <% if (saved) { %><div class="success">✅ 设置已保存成功</div><% } %>

    <form method="post" action="/admin/settings" enctype="multipart/form-data">
      <div class="card">
        <h3>基础信息</h3>
        <div class="grid">
          <div><label>网站名称</label><input name="site_name" value="<%= config.site_name||'' %>"></div>
          <div><label>公司名称</label><input name="company_name" value="<%= config.company_name||'' %>"></div>
          <div><label>联系邮箱</label><input name="contact_email" value="<%= config.contact_email||'' %>"></div>
          <div><label>WhatsApp</label><input name="contact_whatsapp" value="<%= config.contact_whatsapp||'' %>"></div>
          <div><label>地址</label><input name="address" value="<%= config.address||'' %>"></div>
          <div><label>版权文字</label><input name="copyright_text" value="<%= config.copyright_text||'' %>"></div>
        </div>
      </div>

      <div class="card">
        <h3>🎨 背景图片 · 透明度 · 整页透图</h3>
        <p class="hint">支持「图片URL」或「本地上传」。透明度 0~1（0完全透明，1不透明）。勾选「整页透图」后背景覆盖整个页面并可透视内容。</p>
        <div class="grid">
          <div>
            <label>首页 Hero 背景图</label>
            <div class="file-row">
              <input type="text" name="hero_bg" value="<%= config.hero_bg||'' %>" placeholder="https://... 或上传">
              <input type="file" name="hero_bg_file" accept="image/*">
            </div>
            <% if(config.hero_bg){ %><img src="<%= config.hero_bg %>" class="img-preview" alt=""><% } %>
            <label>透明度</label>
            <input type="number" name="hero_bg_opacity" value="<%= config.hero_bg_opacity||'0.35' %>" step="0.05" min="0" max="1">
          </div>
          <div>
            <label>产品区背景图</label>
            <div class="file-row">
              <input type="text" name="products_bg" value="<%= config.products_bg||'' %>" placeholder="https://... 或上传">
              <input type="file" name="products_bg_file" accept="image/*">
            </div>
            <% if(config.products_bg){ %><img src="<%= config.products_bg %>" class="img-preview" alt=""><% } %>
            <label>透明度</label>
            <input type="number" name="products_bg_opacity" value="<%= config.products_bg_opacity||'0.25' %>" step="0.05" min="0" max="1">
          </div>
          <div>
            <label>整页背景图</label>
            <div class="file-row">
              <input type="text" name="page_bg" value="<%= config.page_bg||'' %>" placeholder="https://... 或上传">
              <input type="file" name="page_bg_file" accept="image/*">
            </div>
            <% if(config.page_bg){ %><img src="<%= config.page_bg %>" class="img-preview" alt=""><% } %>
            <label>透明度</label>
            <input type="number" name="page_bg_opacity" value="<%= config.page_bg_opacity||'0.15' %>" step="0.05" min="0" max="1">
            <label class="check-label" style="display:flex;align-items:center;gap:8px;margin-top:8px;">
              <input type="checkbox" name="page_bg_full" value="1" <%= config.page_bg_full==='1'?'checked':'' %>> 整页可透（背景固定覆盖全屏）
            </label>
          </div>
        </div>
      </div>

      <div class="card">
        <h3>🎠 轮播特效（5种 + 随机）</h3>
        <div class="grid">
          <div>
            <label>轮播间隔（毫秒）</label>
            <input type="number" name="carousel_delay" value="<%= config.carousel_delay||'4000' %>" min="1500" step="500">
          </div>
          <div>
            <label>轮播特效</label>
            <select name="carousel_effect">
              <option value="fade" <%= config.carousel_effect==='fade'?'selected':'' %>>淡入淡出 Fade</option>
              <option value="slide" <%= config.carousel_effect==='slide'?'selected':'' %>>左右滑动 Slide</option>
              <option value="zoom" <%= config.carousel_effect==='zoom'?'selected':'' %>>缩放 Zoom</option>
              <option value="flip" <%= config.carousel_effect==='flip'?'selected':'' %>>翻转 Flip</option>
              <option value="cube" <%= config.carousel_effect==='cube'?'selected':'' %>>立方体 Cube</option>
            </select>
          </div>
          <div>
            <label>随机特效</label>
            <select name="carousel_random">
              <option value="0" <%= config.carousel_random!=='1'?'selected':'' %>>关闭（使用上方选定特效）</option>
              <option value="1" <%= config.carousel_random==='1'?'selected':'' %>>开启（每次随机一种特效）</option>
            </select>
          </div>
        </div>
      </div>

      <div class="card">
        <h3>💱 货币汇率（可查看 + 实时更新）</h3>
        <p class="hint">基准货币：1 HKD。可手动修改，或点击「实时获取」从线上自动更新并换算。</p>
        <div class="rate-box">
          <div class="rate-row" id="rateDisplay">
            <div class="rate-item"><strong id="r_usd"><%= config.rate_usd||'0.128' %></strong><span>USD</span></div>
            <div class="rate-item"><strong id="r_cny"><%= config.rate_cny||'0.93' %></strong><span>CNY</span></div>
            <div class="rate-item"><strong id="r_krw"><%= config.rate_krw||'175' %></strong><span>KRW</span></div>
            <div class="rate-item"><strong id="r_jpy"><%= config.rate_jpy||'19.5' %></strong><span>JPY</span></div>
          </div>
          <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;">
            <button type="button" class="btn btn-blue" id="btnFetchRate">🔄 实时获取线上汇率并写入</button>
            <span id="rateMsg" style="font-size:13px;color:#6B7280;align-self:center;"></span>
          </div>
        </div>
        <div class="grid" style="margin-top:16px;">
          <div><label>1 HKD = ? USD</label><input type="number" name="rate_usd" id="in_usd" value="<%= config.rate_usd||'0.128' %>" step="0.0001" min="0"></div>
          <div><label>1 HKD = ? CNY</label><input type="number" name="rate_cny" id="in_cny" value="<%= config.rate_cny||'0.93' %>" step="0.0001" min="0"></div>
          <div><label>1 HKD = ? KRW</label><input type="number" name="rate_krw" id="in_krw" value="<%= config.rate_krw||'175' %>" step="0.01" min="0"></div>
          <div><label>1 HKD = ? JPY</label><input type="number" name="rate_jpy" id="in_jpy" value="<%= config.rate_jpy||'19.5' %>" step="0.01" min="0"></div>
          <div>
            <label>自动使用实时汇率</label>
            <select name="rate_auto">
              <option value="1" <%= config.rate_auto!=='0'?'selected':'' %>>开启</option>
              <option value="0" <%= config.rate_auto==='0'?'selected':'' %>>关闭（仅用手动值）</option>
            </select>
          </div>
        </div>
      </div>

      <div class="card">
        <h3>社交图标（图片 + 链接）</h3>
        <div class="grid">
          <div>
            <label>图标1 图片</label>
            <div class="file-row"><input type="text" name="social1_img" value="<%= config.social1_img||'' %>"><input type="file" name="social1_file" accept="image/*"></div>
            <label>链接1</label><input name="social1_url" value="<%= config.social1_url||'' %>">
          </div>
          <div>
            <label>图标2 图片</label>
            <div class="file-row"><input type="text" name="social2_img" value="<%= config.social2_img||'' %>"><input type="file" name="social2_file" accept="image/*"></div>
            <label>链接2</label><input name="social2_url" value="<%= config.social2_url||'' %>">
          </div>
          <div>
            <label>图标3 图片</label>
            <div class="file-row"><input type="text" name="social3_img" value="<%= config.social3_img||'' %>"><input type="file" name="social3_file" accept="image/*"></div>
            <label>链接3</label><input name="social3_url" value="<%= config.social3_url||'' %>">
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-green" style="font-size:15px;padding:12px 28px;">💾 保存所有设置</button>
    </form>
  </div>
  <script>
    document.getElementById('btnFetchRate').addEventListener('click', async function() {
      const msg = document.getElementById('rateMsg');
      msg.textContent = '正在获取...';
      try {
        const r = await fetch('/admin/api/rates?save=1');
        const j = await r.json();
        if (j.success && j.rates) {
          document.getElementById('r_usd').textContent = j.rates.usd;
          document.getElementById('r_cny').textContent = j.rates.cny;
          document.getElementById('r_krw').textContent = j.rates.krw;
          document.getElementById('r_jpy').textContent = j.rates.jpy;
          document.getElementById('in_usd').value = j.rates.usd;
          document.getElementById('in_cny').value = j.rates.cny;
          document.getElementById('in_krw').value = j.rates.krw;
          document.getElementById('in_jpy').value = j.rates.jpy;
          msg.textContent = '已更新并保存 · ' + (j.rates.updated || '');
        } else {
          msg.textContent = j.message || '获取失败';
        }
      } catch(e) {
        msg.textContent = '网络错误: ' + e.message;
      }
    });
  </script>
</body>
</html>
