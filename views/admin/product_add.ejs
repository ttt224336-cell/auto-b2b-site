<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>新增产品</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
.header{background:#2563eb;color:#fff;padding:16px;font-size:22px}
.container{padding:24px;max-width:850px}
a.btn{display:inline-block;padding:8px 14px;background:#2563eb;color:#fff;text-decoration:none;border-radius:4px;margin:4px 2px}
.form-item{margin:14px 0}
label{display:block;margin-bottom:4px}
input,textarea,select{width:100%;padding:9px;font-size:15px}
</style>
</head>
<body>
<div class="header">新增汽配产品</div>
<div class="container">
    <a href="/admin/product" class="btn">←返回产品列表</a>
    <form action="/admin/product/add" method="POST" enctype="multipart/form-data">

        <div class="form-item">
    <label>① 上传本地汽配图片（推荐，优先使用）</label>
    <input type="file" name="imgfile" accept="image/png,image/jpeg,image/webp">
    <p style="font-size:12px;color:#666">支持jpg/png/webp，选择电脑里的产品实拍图</p>
</div>
<div class="form-item">
    <label>② 图片URL链接（二选一，填网络图片地址）</label>
    <input type="text" name="image" placeholder="https://xxx.jpg">
</div>

        <div class="form-item">
            <label>产品名称</label>
            <input type="text" name="name" required>
        </div>
        <div class="form-item">
            <label>零件号 Part No.</label>
            <input type="text" name="part_no">
        </div>
        <div class="form-item">
            <label>规格参数</label>
            <textarea name="spec"></textarea>
        </div>
        <div class="form-item">
            <label>价格</label>
            <input type="number" step="0.01" name="price">
        </div>
        <div class="form-item">
            <label>产品图片链接</label>
            <input type="text" name="image">
        </div>
        <button class="btn" type="submit">保存产品</button>
    </form>
</div>
</body>
</html>
