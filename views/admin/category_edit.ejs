<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>编辑分类</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
.header{background:#2563eb;color:#fff;padding:16px;font-size:22px}
.container{padding:24px;max-width:800px}
a.btn{display:inline-block;padding:8px 14px;background:#2563eb;color:#fff;text-decoration:none;border-radius:4px;margin:4px 2px}
.form-item{margin:12px 0}
input,textarea{width:100%;padding:8px;font-size:16px}
</style>
</head>
<body>
<div class="header">编辑分类</div>
<div class="container">
    <a href="/admin/category" class="btn">←返回列表</a>
    <form method="POST" action="/admin/category/edit/<%=item.id%>">
        <div class="form-item">
            <label>分类名称</label>
            <input type="text" name="name" value="<%=item.name%>" required>
        </div>
        <div class="form-item">
            <label>备注</label>
            <textarea name="remark"><%=item.remark||''%></textarea>
        </div>
        <button class="btn">保存修改</button>
    </form>
</div>
</body>
</html>
