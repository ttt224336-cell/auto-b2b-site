<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof config !== 'undefined' && config.site_name ? config.site_name : 'AUTO PARTS FACTORY' %></title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;font-family:"Microsoft YaHei",-apple-system,sans-serif;}
    :root{
      --main-dark:#0B2C58;
      --blue:#22577A;
      --light:#f5f7fa;
      --gray:#e9ecef;
      --text:#333;
      --r:10px;
    }
    body{background:var(--light);color:var(--text);min-height:100vh;display:flex;flex-direction:column;}
    a{text-decoration:none;color:inherit;}
    
    /* ===== 顶部导航 ===== */
    .header{
      background:var(--main-dark);
      color:#fff;
      position:sticky;top:0;z-index:100;
      box-shadow:0 2px 12px rgba(0,0,0,.15);
    }
    .header-inner{
      max-width:1280px;margin:0 auto;
      padding:14px 20px;
      display:flex;align-items:center;justify-content:space-between;gap:20px;
    }
    .logo{font-size:22px;font-weight:700;letter-spacing:1px;}
    .logo span{color:#7dd3fc;}
    .search-box{
      flex:1;max-width:480px;
      display:flex;background:#fff;border-radius:8px;overflow:hidden;
    }
    .search-box input{
      flex:1;border:none;padding:10px 16px;font-size:15px;outline:none;
    }
    .search-box button{
      background:var(--blue);color:#fff;border:none;padding:0 20px;cursor:pointer;font-size:15px;
    }
    .header-right a{
      color:#fff;margin-left:16px;font-size:14px;opacity:.9;
    }
    .header-right a:hover{opacity:1;}

    /* ===== 主体布局 ===== */
    .container{
      max-width:1280px;margin:0 auto;padding:24px 20px;
      display:flex;gap:24px;flex:1;
    }
    
    /* 左侧分类 */
    .sidebar{
      width:220px;flex-shrink:0;
    }
    .side-card{
      background:#fff;border-radius:var(--r);
      box-shadow:0 2px 10px rgba(0,0,0,.05);
      overflow:hidden;
    }
    .side-card h3{
      background:var(--main-dark);color:#fff;
      padding:14px 18px;font-size:15px;
    }
    .cat-list a{
      display:block;padding:12px 18px;
      border-bottom:1px solid var(--gray);
      font-size:14px;transition:.15s;
    }
    .cat-list a:hover,.cat-list a.active{
      background:#e8f4fc;color:var(--blue);font-weight:600;
    }
    .cat-list a:last-child{border-bottom:none;}

    /* 右侧内容 */
    .main{flex:1;min-width:0;}
    
    /* 筛选栏 */
    .filter-bar{
      background:#fff;border-radius:var(--r);
      padding:14px 18px;margin-bottom:20px;
      display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;
      box-shadow:0 2px 8px rgba(0,0,0,.04);
    }
    .filter-bar .count{font-size:14px;color:#666;}
    .sort-btns a{
      display:inline-block;padding:6px 14px;margin-left:6px;
      border-radius:6px;font-size:13px;background:#f1f3f5;color:#555;
    }
    .sort-btns a.active,.sort-btns a:hover{
      background:var(--blue);color:#fff;
    }

    /* 产品网格 */
    .product-grid{
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
      gap:20px;
    }
    .product-card{
      background:#fff;border-radius:var(--r);
      overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.05);
      transition:transform .2s,box-shadow .2s;
    }
    .product-card:hover{
      transform:translateY(-4px);
      box-shadow:0 8px 24px rgba(0,0,0,.1);
    }
    .product-img{
      height:180px;background:#f8f9fa;
      display:flex;align-items:center;justify-content:center;
      overflow:hidden;
    }
    .product-img img{
      max-width:100%;max-height:100%;object-fit:contain;
    }
    .no-img{
      color:#bbb;font-size:14px;
    }
    .product-info{padding:16px;}
    .product-info h3{
      font-size:15px;margin-bottom:8px;
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
      height:42px;
    }
    .product-info .oe{font-size:12px;color:#888;margin-bottom:6px;}
    .product-info .price{
      font-size:18px;font-weight:700;color:var(--blue);
    }
    .product-info .price span{font-size:13px;font-weight:400;}

    /* 详情页 */
    .detail-wrap{
      background:#fff;border-radius:var(--r);
      padding:28px;box-shadow:0 2px 12px rgba(0,0,0,.05);
    }
    .detail-top{display:flex;gap:32px;flex-wrap:wrap;}
    .detail-img{
      width:380px;max-width:100%;
      background:#f8f9fa;border-radius:8px;
      display:flex;align-items:center;justify-content:center;
      min-height:300px;
    }
    .detail-img img{max-width:100%;max-height:360px;object-fit:contain;}
    .detail-info{flex:1;min-width:280px;}
    .detail-info h1{font-size:24px;margin-bottom:16px;line-height:1.4;}
    .detail-info .meta{margin-bottom:12px;font-size:14px;color:#555;}
    .detail-info .meta b{color:#333;min-width:70px;display:inline-block;}
    .detail-price{
      font-size:28px;font-weight:700;color:var(--blue);
      margin:20px 0;
    }
    .detail-desc{
      margin-top:28px;padding-top:24px;border-top:1px solid var(--gray);
      line-height:1.7;color:#555;font-size:15px;
    }
    .back-btn{
      display:inline-block;margin-bottom:20px;
      padding:8px 18px;background:#e9ecef;border-radius:6px;font-size:14px;
    }
    .back-btn:hover{background:#dee2e6;}

    /* 空状态 */
    .empty{
      text-align:center;padding:60px 20px;color:#999;
      background:#fff;border-radius:var(--r);
    }

    /* 底部 */
    .footer{
      background:var(--main-dark);color:rgba(255,255,255,.7);
      text-align:center;padding:20px;font-size:13px;margin-top:40px;
    }

    /* WhatsApp 悬浮 */
    .wa-float{
      position:fixed;right:24px;bottom:24px;z-index:99;
      width:56px;height:56px;border-radius:50%;
      background:#25D366;color:#fff;
      display:flex;align-items:center;justify-content:center;
      font-size:28px;box-shadow:0 4px 16px rgba(37,211,102,.4);
      transition:transform .2s;
    }
    .wa-float:hover{transform:scale(1.08);}

    /* 响应式 */
    @media(max-width:900px){
      .container{flex-direction:column;}
      .sidebar{width:100%;}
      .cat-list{display:flex;flex-wrap:wrap;gap:8px;padding:12px;}
      .cat-list a{border:1px solid var(--gray);border-radius:6px;padding:8px 14px;}
      .detail-top{flex-direction:column;}
      .detail-img{width:100%;}
    }
    @media(max-width:600px){
      .header-inner{flex-wrap:wrap;}
      .search-box{order:3;max-width:100%;width:100%;}
      .product-grid{grid-template-columns:repeat(2,1fr);gap:12px;}
      .product-img{height:140px;}
    }
  </style>
</head>
<body>

  <!-- 顶部 -->
  <header class="header">
    <div class="header-inner">
      <a href="/" class="logo">AUTO <span>PARTS</span></a>
      
      <form class="search-box" action="/" method="get">
        <% if(typeof catId !== 'undefined' && catId){ %>
          <input type="hidden" name="cat" value="<%= catId %>">
        <% } %>
        <input type="text" name="q" placeholder="搜索产品名称 / OE号 / 车型..." value="<%= typeof keyword !== 'undefined' ? keyword : '' %>">
        <button type="submit">搜索</button>
      </form>

      <div class="header-right">
        <a href="/admin" target="_blank">管理后台</a>
      </div>
    </div>
  </header>

  <div class="container">
    <!-- 左侧分类 -->
    <aside class="sidebar">
      <div class="side-card">
        <h3>全部分类</h3>
        <div class="cat-list">
          <a href="/" class="<%= (!catId || catId==='') ? 'active' : '' %>">全部产品</a>
          <% if(typeof categories !== 'undefined' && categories && categories.length){ %>
            <% categories.forEach(c => { %>
              <a href="/?cat=<%= c.id %><%= keyword ? '&q='+encodeURIComponent(keyword) : '' %>"
                 class="<%= String(catId) === String(c.id) ? 'active' : '' %>">
                <%= c.name %>
              </a>
            <% }) %>
          <% } %>
        </div>
      </div>
    </aside>

    <!-- 右侧主内容 -->
    <main class="main">

      <% if(page === 'list'){ %>
        <!-- ===== 列表页 ===== -->
        <div class="filter-bar">
          <div class="count">
            共找到 <b><%= typeof products !== 'undefined' && products ? products.length : 0 %></b> 个产品
            <% if(keyword){ %> · 关键词「<%= keyword %>」<% } %>
          </div>
          <div class="sort-btns">
            <a href="/?<%= catId ? 'cat='+catId+'&' : '' %><%= keyword ? 'q='+encodeURIComponent(keyword)+'&' : '' %>sort=date"
               class="<%= (!sort || sort==='date') ? 'active' : '' %>">最新</a>
            <a href="/?<%= catId ? 'cat='+catId+'&' : '' %><%= keyword ? 'q='+encodeURIComponent(keyword)+'&' : '' %>sort=priceAsc"
               class="<%= sort==='priceAsc' ? 'active' : '' %>">价格↑</a>
            <a href="/?<%= catId ? 'cat='+catId+'&' : '' %><%= keyword ? 'q='+encodeURIComponent(keyword)+'&' : '' %>sort=priceDesc"
               class="<%= sort==='priceDesc' ? 'active' : '' %>">价格↓</a>
          </div>
        </div>

        <% if(typeof products !== 'undefined' && products && products.length){ %>
          <div class="product-grid">
            <% products.forEach(p => { %>
              <a href="/product/<%= p.id %>" class="product-card">
                <div class="product-img">
                  <% if(p.image){ %>
                    <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"
                         onerror="this.parentElement.innerHTML='<div class=no-img>暂无图片</div>'">
                  <% } else { %>
                    <div class="no-img">暂无图片</div>
                  <% } %>
                </div>
                <div class="product-info">
                  <h3><%= p.name %></h3>
                  <% if(p.oe){ %><div class="oe">OE: <%= p.oe %></div><% } %>
                  <div class="price"><span>HK$</span><%= Number(p.price||0).toFixed(2) %></div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty">暂无符合条件的产品</div>
        <% } %>

      <% } else if(page === 'detail'){ %>
        <!-- ===== 详情页 ===== -->
        <a href="javascript:history.back()" class="back-btn">← 返回列表</a>

        <% if(product){ %>
          <div class="detail-wrap">
            <div class="detail-top">
              <div class="detail-img">
                <% if(product.image){ %>
                  <img src="<%= product.image %>" alt="<%= product.name %>"
                       onerror="this.parentElement.innerHTML='<div class=no-img>暂无图片</div>'">
                <% } else { %>
                  <div class="no-img">暂无图片</div>
                <% } %>
              </div>
              <div class="detail-info">
                <h1><%= product.name %></h1>
                <div class="meta"><b>OE编号：</b><%= product.oe || '-' %></div>
                <div class="meta"><b>适用车型：</b><%= product.model || '-' %></div>
                <div class="meta"><b>库存：</b><%= product.stock != null ? product.stock : '-' %></div>
                <div class="detail-price">HK$ <%= Number(product.price||0).toFixed(2) %></div>
                
                <% if(config && config.wa){ %>
                  <a href="https://wa.me/<%= config.wa.replace(/[^0-9]/g,'') %>?text=您好，我想咨询产品：<%= encodeURIComponent(product.name) %>"
                     target="_blank"
                     style="display:inline-block;background:#25D366;color:#fff;padding:12px 28px;border-radius:8px;font-size:15px;">
                    💬 WhatsApp 询价
                  </a>
                <% } %>
              </div>
            </div>

            <% if(product.description){ %>
              <div class="detail-desc">
                <h3 style="margin-bottom:12px;color:#333;">产品说明</h3>
                <%= product.description %>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="empty">产品不存在或已下架</div>
        <% } %>
      <% } %>

    </main>
  </div>

  <footer class="footer">
    <%= typeof config !== 'undefined' && config.copyright_text ? config.copyright_text : '© AUTO PARTS FACTORY' %>
    <% if(typeof config !== 'undefined' && config.email){ %> · <%= config.email %><% } %>
  </footer>

  <!-- WhatsApp 悬浮按钮 -->
  <% if(typeof config !== 'undefined' && config.wa){ %>
    <a href="https://wa.me/<%= config.wa.replace(/[^0-9]/g,'') %>" 
       class="wa-float" target="_blank" title="WhatsApp 联系我们">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  <% } %>

</body>
</html>
