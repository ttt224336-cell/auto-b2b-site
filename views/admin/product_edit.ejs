<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>编辑产品</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
.header{background:#2563eb;color:#fff;padding:16px;font-size:22px}
.container{padding:24px;max-width:850px}
a.btn{display:inline-block;padding:8px 14px;background:#2563eb;color:#fff;text-decoration:none;border-radius:4px;margin:4px 2px}
.form-item{margin:14px 0}
label{display:block;margin-bottom:4px}
input,textarea,select{width:100%;padding:9px;font-size:15px}
</style>
</head>
<body>
<div class="header">编辑汽配产品</div>
<div class="container">
    <a href="/admin/product" class="btn">←返回产品列表</a>
    <form method="POST" action="/admin/product/edit/<%=item.id%>" enctype="multipart/form-data">

        <div class="form-item">
    <label>① 上传新图片（不选择文件，保留原来图片）</label>
    <input type="file" name="imgfile" accept="image/png,image/jpeg,image/webp">
    <% if(item.image){ %>
        <div style="margin:10px 0;">
            <span>当前图片预览：</span>
            <img src="<%= item.image %>" style="max-width:200px;max-height:160px;border:1px solid #ccc;">
        </div>
    <% } %>
</div>
<div class="form-item">
    <label>② 图片URL链接</label>
    <input type="text" name="image" value="<%= item.image || '' %>">
</div>


        <div class="form-item">
            <label>产品名称</label>
            <input type="text" name="name" value="<%=item.name%>" required>
        </div>
        <div class="form-item">
            <label>零件号 Part No.</label>
            <input type="text" name="part_no" value="<%=item.part_no||''%>">
        </div>
        <div class="form-item">
            <label>规格参数</label>
            <textarea name="spec"><%=item.spec||''%></textarea>
        </div>
        <div class="form-item">
            <label>价格</label>
            <input type="number" step="0.01" name="price" value="<%=item.price||0%>">
        </div>
        <div class="form-item">
            <label>产品图片链接</label>
            <input type="text" name="image" value="<%=item.image||''%>">
        </div>
        <button class="btn">保存修改</button>
    </form>
</div>
</body>
</html>
