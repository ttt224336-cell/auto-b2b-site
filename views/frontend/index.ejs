<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (typeof product !== 'undefined' && product) ? (product.name_zh || product.name_en || 'Product') : ((config && config.site_name) || 'AutoParts B2B') %> | Auto Parts</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --main: #0A2F5F; --blue: #1E6BD9; --accent: #F59E0B; --light: #F3F4F6;
      --text: #1F2937; --muted: #6B7280; --white: #fff; --r: 12px;
    }
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Inter', system-ui, sans-serif; }
    body { background: #F1F5F9; color: var(--text); line-height:1.6; min-height:100vh; }
    a { text-decoration:none; color:inherit; }
    img { max-width:100%; display:block; }

    /* 整页背景：柔和遮罩，避免刺眼 */
    body.page-bg-full { background-size:cover; background-position:center; background-attachment:fixed; }
    body.page-bg-full::before {
      content:''; position:fixed; inset:0; z-index:-1; pointer-events:none;
      background: linear-gradient(180deg, rgba(248,250,252,.92), rgba(241,245,249,.94));
    }

    /* Header */
    .header {
      position:sticky; top:0; z-index:100; background:var(--main); color:#fff;
      box-shadow:0 2px 12px rgba(0,0,0,.15);
    }
    .header-inner {
      max-width:1200px; margin:0 auto; padding:14px 20px;
      display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
    }
    .logo { font-size:18px; font-weight:700; letter-spacing:-.02em; }
    .nav { display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
    .nav a { color:rgba(255,255,255,.9); font-size:14px; font-weight:500; }
    .nav a:hover { color:var(--accent); }
    .lang-cur { display:flex; align-items:center; gap:8px; }
    .lang-cur button {
      background:transparent; border:1px solid rgba(255,255,255,.4); color:#fff;
      padding:5px 12px; border-radius:6px; font-size:12px; cursor:pointer; font-weight:500;
    }
    .lang-cur button.active { background:var(--accent); border-color:var(--accent); color:#111; font-weight:700; }
    /* 货币下拉：深色字 + 白底，展开可见 */
    #currencySelect {
      appearance:auto; -webkit-appearance:menulist;
      background:#fff !important; color:#111 !important;
      border:1px solid #D1D5DB; border-radius:6px;
      padding:5px 8px; font-size:12px; font-weight:600; cursor:pointer; min-width:72px;
    }
    #currencySelect option { background:#fff; color:#111; }

    /* Hero：更干净的遮罩，文字更清晰 */
    .hero {
      padding:64px 20px; text-align:center; position:relative; overflow:hidden;
      background: linear-gradient(135deg, #0A2F5F 0%, #1E6BD9 55%, #3B82F6 100%);
      color:#fff;
    }
    .hero::before {
      content:''; position:absolute; inset:0; z-index:0;
      <% if (config && config.hero_bg) { %>
      background-image: url('<%= config.hero_bg %>');
      background-size:cover; background-position:center;
      opacity: <%= Math.min(0.35, parseFloat(config.hero_bg_opacity||0.3) || 0.3) %>;
      <% } else { %>
      opacity:0;
      <% } %>
    }
    .hero::after {
      content:''; position:absolute; inset:0; z-index:0;
      background: linear-gradient(135deg, rgba(10,47,95,.82), rgba(30,107,217,.75));
    }
    .hero > * { position:relative; z-index:1; }
    .hero h1 { font-size:clamp(1.55rem,4vw,2.35rem); margin-bottom:12px; font-weight:700; text-shadow:0 1px 2px rgba(0,0,0,.2); }
    .hero p { color:rgba(255,255,255,.9); max-width:640px; margin:0 auto 24px; font-size:15px; }
    .btn {
      display:inline-flex; align-items:center; justify-content:center; gap:6px;
      padding:11px 22px; border-radius:8px; font-size:14px; font-weight:600; border:none; cursor:pointer;
      transition: box-shadow .15s, background .15s; /* 无缩放抖动 */
    }
    .btn-main { background:#fff; color:var(--main); box-shadow:0 4px 14px rgba(0,0,0,.15); }
    .btn-main:hover { box-shadow:0 6px 18px rgba(0,0,0,.2); }
    .btn-accent { background:var(--accent); color:#111; }
    .btn-outline { background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,.6); }

    /* Factory */
    .section { padding:48px 20px; }
    .section-title { text-align:center; font-size:clamp(1.25rem,3vw,1.6rem); font-weight:700; color:var(--main); margin-bottom:6px; }
    .section-sub { text-align:center; color:var(--muted); font-size:14px; margin-bottom:28px; }
    .factory-grid {
      max-width:1100px; margin:0 auto;
      display:grid; grid-template-columns:1.1fr 1fr; gap:28px; align-items:center;
    }
    .factory-slider {
      position:relative; border-radius:14px; overflow:hidden; aspect-ratio:16/10;
      background:#E2EBF5; box-shadow:0 8px 28px rgba(10,47,95,.08);
    }
    .factory-slider .slide {
      position:absolute; inset:0; opacity:0; background-size:cover; background-position:center;
      transition: opacity .7s ease;
    }
    .factory-slider .slide.active { opacity:1; }
    .slider-dots {
      position:absolute; bottom:12px; left:0; right:0; display:flex; justify-content:center; gap:6px; z-index:2;
    }
    .slider-dots span {
      width:8px; height:8px; border-radius:50%; background:rgba(255,255,255,.5); cursor:pointer;
    }
    .slider-dots span.active { background:#fff; transform:scale(1.2); }
    .factory-info h3 { font-size:1.2rem; color:var(--main); margin-bottom:10px; }
    .factory-info p { color:var(--muted); font-size:14px; margin-bottom:14px; }
    .adv-list { list-style:none; }
    .adv-list li { display:flex; gap:10px; align-items:flex-start; margin-bottom:8px; font-size:14px; }
    .adv-list .icon {
      width:22px; height:22px; border-radius:50%; background:linear-gradient(135deg,#1E6BD9,#0A2F5F);
      color:#fff; font-size:11px; display:flex; align-items:center; justify-content:center; flex-shrink:0;
    }

    /* Products：底图用轻遮罩，内容可读 */
    .products-section {
      padding:48px 16px 64px; position:relative;
      background: #EEF2F7;
    }
    .products-section.has-bg::before {
      content:''; position:absolute; inset:0; z-index:0;
      background-size:cover; background-position:center;
      opacity: 0.18;
      pointer-events:none;
    }
    .products-section > * { position:relative; z-index:1; }
    .products-layout {
      max-width:1180px; margin:0 auto;
      display:grid; grid-template-columns:200px 1fr; gap:20px; align-items:start;
    }
    .sidebar-cat {
      position:sticky; top:74px; background:#fff; border-radius:var(--r); padding:16px;
      box-shadow:0 2px 10px rgba(0,0,0,.05); border:1px solid #E5E7EB;
    }
    .sidebar-cat h4 { font-size:12px; color:var(--muted); margin-bottom:10px; letter-spacing:.04em; }
    .cat-list a {
      display:block; padding:9px 12px; border-radius:8px; font-size:13px; color:var(--text);
      margin-bottom:4px; transition: background .15s, color .15s;
    }
    .cat-list a:hover { background:#EBF2FB; color:var(--blue); }
    .cat-list a.active { background:var(--blue); color:#fff; font-weight:600; }

    .toolbar { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px; align-items:center; }
    .toolbar input, .toolbar select {
      padding:9px 12px; border:1px solid #D1D5DB; border-radius:8px; font-size:13px; outline:none; background:#fff; color:#111;
    }
    .toolbar input:focus { border-color:var(--blue); }
    .product-grid {
      display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px;
    }
    /* 卡片：取消上移抖动，仅轻微阴影 */
    .card {
      background:#fff; border-radius:var(--r); overflow:hidden;
      box-shadow:0 1px 4px rgba(0,0,0,.06); border:1px solid #E5E7EB;
      transition: box-shadow .2s, border-color .2s;
    }
    .card:hover {
      box-shadow:0 6px 20px rgba(10,47,95,.1);
      border-color:#C7D2FE;
    }
    .card:active { box-shadow:0 1px 4px rgba(0,0,0,.08); }
    .card-img { aspect-ratio:1; background:#F1F5F9; overflow:hidden; }
    .card-img img { width:100%; height:100%; object-fit:cover; transition:none; }
    .card-body { padding:14px; }
    .card-body h3 { font-size:14px; font-weight:600; color:var(--main); margin-bottom:6px; line-height:1.35; }
    .card-meta { font-size:12px; color:var(--muted); margin-bottom:8px; }
    .price { font-size:16px; font-weight:700; color:var(--blue); }
    .price .cur-sym { font-size:12px; margin-right:2px; }

    /* Detail */
    .detail-wrap { max-width:1000px; margin:0 auto; padding:32px 20px 60px; }
    .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:32px; align-items:start; }
    .detail-img { border-radius:var(--r); overflow:hidden; background:#F1F5F9; aspect-ratio:1; border:1px solid #E5E7EB; }
    .detail-img img { width:100%; height:100%; object-fit:cover; }
    .detail-info h1 { font-size:1.5rem; color:var(--main); margin-bottom:12px; }
    .detail-info .meta { background:#F8FAFC; padding:12px 14px; border-radius:8px; margin:14px 0; font-size:14px; border:1px solid #E5E7EB; }
    .detail-info .meta p { margin-bottom:4px; }
    .spec-list { list-style:none; margin:16px 0; }
    .spec-list li { padding:8px 0; border-bottom:1px solid #E5E7EB; font-size:14px; }

    /* ===== 询盘区 ===== */
    .inquiry-wrap {
      padding: 64px 20px;
      background: linear-gradient(160deg, #EEF3FA 0%, #E2EAF5 50%, #D8E4F2 100%);
      position: relative;
    }
    .inquiry-wrap::before {
      content:''; position:absolute; inset:0; pointer-events:none;
      background: radial-gradient(ellipse at 20% 0%, rgba(30,107,217,.08), transparent 50%),
                  radial-gradient(ellipse at 80% 100%, rgba(245,158,11,.06), transparent 45%);
    }
    .inquiry-inner { max-width:1080px; margin:0 auto; position:relative; z-index:1; }
    .inquiry-inner .section-title { margin-bottom:8px; }
    .inquiry-grid {
      display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:32px;
    }
    .inq-card {
      background:#fff; border-radius:16px; padding:28px 22px; text-align:center;
      box-shadow:0 6px 24px rgba(10,47,95,.07); border:1px solid rgba(255,255,255,.8);
      transition: transform .2s, box-shadow .2s;
    }
    .inq-card:hover { transform:translateY(-4px); box-shadow:0 12px 32px rgba(10,47,95,.12); }
    .inq-icon {
      width:56px; height:56px; margin:0 auto 16px; border-radius:16px;
      display:flex; align-items:center; justify-content:center; font-size:26px;
      background:linear-gradient(135deg, #1E6BD9 0%, #0A2F5F 100%);
      box-shadow:0 6px 16px rgba(30,107,217,.35);
    }
    .inq-card h4 { font-size:16px; font-weight:700; color:#0A2F5F; margin-bottom:8px; }
    .inq-card p { font-size:13px; color:#6B7280; line-height:1.6; word-break:break-all; }
    .inq-actions { text-align:center; margin-top:32px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
    .inq-actions .btn { min-width:150px; padding:12px 24px; border-radius:10px; font-weight:600; }
    .btn-wa { background:#25D366; color:#fff; }
    .btn-wa:hover { background:#1ebe57; }
    .btn-mail { background:#fff; color:#1E6BD9; border:2px solid #1E6BD9; }
    .btn-mail:hover { background:#EFF6FF; }

    /* ===== 页脚三栏 ===== */
    footer {
      background: linear-gradient(180deg, #0A2F5F 0%, #071E3D 100%);
      color:#CBD5E1; padding:52px 20px 28px; margin-top:0;
    }
    .foot-inner {
      max-width:1100px; margin:0 auto;
      display:grid; grid-template-columns:1fr 1fr 1fr; gap:24px;
    }
    .foot-panel {
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 14px;
      padding: 24px 22px;
      min-height: 180px;
    }
    .foot-panel h4 {
      color: #F59E0B; font-size:14px; font-weight:700; margin-bottom:16px;
      letter-spacing:.04em; text-transform:uppercase;
      display:flex; align-items:center; gap:8px;
    }
    .foot-panel h4 .dot {
      width:8px; height:8px; border-radius:50%; background:#F59E0B;
      box-shadow:0 0 8px rgba(245,158,11,.6);
    }
    .foot-panel .brand { color:#F8FAFC; font-size:16px; font-weight:700; margin-bottom:8px; }
    .foot-panel p, .foot-panel a {
      font-size:13px; line-height:1.85; color:#94A3B8; text-decoration:none; display:block;
    }
    .foot-panel a:hover { color:#F59E0B; }
    .foot-panel .link-row { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
    .foot-panel .link-row span.icon { width:18px; text-align:center; opacity:.7; }
    .foot-social-row {
      max-width:1100px; margin:28px auto 0; padding-top:24px;
      border-top:1px solid rgba(255,255,255,.1);
      display:flex; flex-direction:column; align-items:center; gap:14px;
    }
    .foot-social-row .lab { font-size:12px; color:#64748B; letter-spacing:.08em; text-transform:uppercase; }
    .social-bar { display:flex; flex-wrap:wrap; gap:18px; justify-content:center; }
    .social-item {
      display:flex; flex-direction:column; align-items:center; gap:6px;
      color:#94A3B8; font-size:12px; text-decoration:none;
    }
    .social-item img {
      width:46px; height:46px; border-radius:50%; object-fit:cover;
      border:2px solid rgba(255,255,255,.12); background:#fff;
      transition: transform .2s, border-color .2s;
    }
    .social-item:hover { color:#F59E0B; }
    .social-item:hover img { transform:translateY(-3px); border-color:#F59E0B; }
    .copyright {
      text-align:center; margin-top:20px; padding-top:16px;
      border-top:1px solid rgba(255,255,255,.08); font-size:12px; color:#64748B;
    }
    @media (max-width:900px) {
      .inquiry-grid, .foot-inner { grid-template-columns:1fr; }
      .foot-panel { min-height:auto; }
    }


    .wa-float {
      position:fixed; bottom:24px; right:24px; z-index:90;
      background:#25D366; color:#fff; padding:12px 18px; border-radius:50px;
      box-shadow:0 4px 16px rgba(37,211,102,.4); font-weight:600; font-size:14px;
      display:flex; align-items:center; gap:8px;
    }
    .empty { text-align:center; padding:48px 20px; color:var(--muted); }

    /* 语言：用 class 切换显隐 */
    .i18n-en { display:none !important; }
    html[lang="en"] .i18n-zh { display:none !important; }
    html[lang="en"] .i18n-en { display:inline !important; }
    html[lang="en"] .i18n-en-block { display:block !important; }
    .i18n-en-block { display:none !important; }
    html[lang="zh-CN"] .i18n-en-block, html[lang="zh"] .i18n-en-block { display:none !important; }

    @media (max-width:900px) {
      .factory-grid, .detail-grid, .products-layout { grid-template-columns:1fr !important; }
      .sidebar-cat { position:static; }
      .cat-list { display:flex; flex-wrap:wrap; gap:6px; }
      .cat-list a { margin:0; }
      .product-grid { grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); }
    }

    /* 回顶按钮 */
    .scroll-top {
      position:fixed; bottom:90px; right:24px; z-index:89;
      width:44px; height:44px; border-radius:50%; border:none; cursor:pointer;
      background:var(--main); color:#fff; font-size:20px; box-shadow:0 4px 14px rgba(0,0,0,.2);
      display:none; align-items:center; justify-content:center;
      transition: opacity .2s, background .2s;
    }
    .scroll-top.show { display:flex; }
    .scroll-top:hover { background:var(--blue); }
    /* 手机返回 */
    .mobile-back {
      display:none; position:fixed; top:12px; left:12px; z-index:110;
      width:40px; height:40px; border-radius:50%; border:none; cursor:pointer;
      background:rgba(10,47,95,.9); color:#fff; font-size:18px;
      align-items:center; justify-content:center; box-shadow:0 2px 10px rgba(0,0,0,.25);
    }
    @media (max-width:768px) {
      .mobile-back { display:flex; }
      .header-inner { padding-left:56px; }
    }
    /* 社交图标 */
    .social-bar {
      display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin-top:16px;
    }
    .social-item {
      display:flex; flex-direction:column; align-items:center; gap:6px;
      text-decoration:none; color:#94A3B8; font-size:12px; min-width:64px;
    }
    .social-item img {
      width:40px; height:40px; border-radius:50%; object-fit:cover;
      border:2px solid rgba(255,255,255,.2); background:#fff;
    }
    .social-item:hover { color:var(--accent); }
    .social-item:hover img { border-color:var(--accent); }

  </style>
</head>
<body class="<%= (config && config.page_bg_full==='1' && config.page_bg) ? 'page-bg-full' : '' %>"
  <% if (config && config.page_bg_full==='1' && config.page_bg) { %>style="background-image:url('<%= config.page_bg %>')"<% } %>>

  <button type="button" class="mobile-back" id="mobileBack" aria-label="Back">←</button>
  <header class="header">
    <div class="header-inner">
      <a href="/" class="logo"><%= (config && config.site_name) || 'AutoParts B2B' %></a>
      <nav class="nav">
        <a href="/"><span class="i18n-zh">首页</span><span class="i18n-en">Home</span></a>
        <a href="/#products"><span class="i18n-zh">产品</span><span class="i18n-en">Products</span></a>
        <a href="/#factory"><span class="i18n-zh">工厂</span><span class="i18n-en">Factory</span></a>
        <a href="/#inquiry"><span class="i18n-zh">询盘</span><span class="i18n-en">Inquiry</span></a>
        <div class="lang-cur">
          <button type="button" data-lang="zh" class="lang-btn active">中文</button>
          <button type="button" data-lang="en" class="lang-btn">EN</button>
          <select id="currencySelect" aria-label="Currency">
            <option value="HKD">HKD</option>
            <option value="USD">USD</option>
            <option value="CNY">CNY</option>
            <option value="KRW">KRW</option>
            <option value="JPY">JPY</option>
          </select>
        </div>
      </nav>
    </div>
  </header>

  <% if (typeof page === 'undefined' || page === 'list') { %>
  <section class="hero">
    <h1>
      <span class="i18n-zh"><%= (config && config.company_name) || '汽配通 · 工业自动化配件' %></span>
      <span class="i18n-en"><%= (config && config.company_name) || 'Auto Parts B2B' %></span>
    </h1>
    <p>
      <span class="i18n-zh">一站式汽车零部件 B2B 采购平台 · OEM / ODM · 全球发货</span>
      <span class="i18n-en">One-stop auto parts B2B platform · OEM / ODM · Global shipping</span>
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="#products" class="btn btn-main"><span class="i18n-zh">浏览产品</span><span class="i18n-en">Browse Products</span></a>
      <a href="#inquiry" class="btn btn-accent"><span class="i18n-zh">立即询盘</span><span class="i18n-en">Inquiry Now</span></a>
    </div>
  </section>

  <section class="section" id="factory" style="background:#fff;">
    <h2 class="section-title">
      <span class="i18n-zh"><%= (factory && factory.title_zh) || '现代化生产基地' %></span>
      <span class="i18n-en"><%= (factory && factory.title_en) || 'Modern Manufacturing Base' %></span>
    </h2>
    <p class="section-sub">
      <span class="i18n-zh"><%= (factory && factory.title_en) || '' %></span>
      <span class="i18n-en"><%= (factory && factory.title_zh) || '' %></span>
    </p>
    <div class="factory-grid">
      <div class="factory-slider" id="factorySlider">
        <% 
          var fImgs = [];
          if (factory && factory.images) {
            fImgs = String(factory.images).split(',').map(function(s){return s.trim();}).filter(Boolean);
          }
          if (!fImgs.length) fImgs = ['https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=800&q=80'];
          fImgs.forEach(function(src, i){ 
        %>
          <div class="slide <%= i===0?'active':'' %>" style="background-image:url('<%= src %>')"></div>
        <% }); %>
        <div class="slider-dots">
          <% fImgs.forEach(function(_, i){ %><span data-index="<%= i %>" class="<%= i===0?'active':'' %>"></span><% }); %>
        </div>
      </div>
      <div class="factory-info">
        <h3>
          <span class="i18n-zh"><%= (factory && factory.title_zh) || '实力铸就品质' %></span>
          <span class="i18n-en"><%= (factory && factory.title_en) || 'Quality Built on Strength' %></span>
        </h3>
        <p>
          <span class="i18n-zh"><%= (factory && factory.intro_zh) || '专业汽配制造，严格品控，服务全球客户。' %></span>
          <span class="i18n-en"><%= (factory && factory.intro_en) || 'Professional auto parts manufacturing with strict QC for global customers.' %></span>
        </p>
        <ul class="adv-list">
          <% 
            var advZh = (factory && factory.advantages_zh) ? String(factory.advantages_zh).split('|') : ['ISO认证','快速交期','OEM/ODM'];
            var advEn = (factory && factory.advantages_en) ? String(factory.advantages_en).split('|') : advZh;
            for (var ai=0; ai<advZh.length; ai++) {
              if (!String(advZh[ai]).trim()) continue;
          %>
            <li>
              <span class="icon">✓</span>
              <span>
                <span class="i18n-zh"><%= String(advZh[ai]).trim() %></span>
                <span class="i18n-en"><%= String(advEn[ai] || advZh[ai]).trim() %></span>
              </span>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
