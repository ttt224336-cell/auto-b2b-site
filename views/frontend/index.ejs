  <a href="https://wa.me/<%= String(config.wa).replace(/[^0-9]/g,'') %>" class="wa-float" target="_blank" rel="noopener">💬 WhatsApp</a>
  <% } %>

  <script>
    window.__RATES = {
      HKD: 1,
      USD: parseFloat('<%= (config && config.rate_usd) || "0.128" %>') || 0.128,
      CNY: parseFloat('<%= (config && config.rate_cny) || "0.93" %>') || 0.93,
      KRW: parseFloat('<%= (config && config.rate_krw) || "175" %>') || 175,
      JPY: parseFloat('<%= (config && config.rate_jpy) || "19.5" %>') || 19.5
    };
    window.__SYMBOLS = { HKD:'HK$', USD:'US$', CNY:'¥', KRW:'₩', JPY:'¥' };

    // 中英文切换（真正切换页面文案）
    (function(){
      var btns = document.querySelectorAll('.lang-btn');
      var saved = localStorage.getItem('lang') || 'zh';
      function setLang(lang) {
        document.documentElement.setAttribute('lang', lang === 'en' ? 'en' : 'zh-CN');
        btns.forEach(function(b){ b.classList.toggle('active', b.getAttribute('data-lang') === lang); });
        localStorage.setItem('lang', lang);
      }
      setLang(saved);
      btns.forEach(function(btn){
        btn.addEventListener('click', function(){ setLang(btn.getAttribute('data-lang')); });
      });
    })();

    // 货币切换
    (function(){
      var sel = document.getElementById('currencySelect');
      if (!sel) return;
      var rates = window.__RATES, symbols = window.__SYMBOLS;
      var saved = localStorage.getItem('currency') || 'HKD';
      if (rates[saved]) sel.value = saved;
      function format(n, cur) {
        if (cur === 'KRW' || cur === 'JPY') return Math.round(n).toLocaleString();
        return Number(n).toFixed(2);
      }
      function apply(cur) {
        var rate = rates[cur] || 1, sym = symbols[cur] || cur;
        document.querySelectorAll('.price[data-hkd]').forEach(function(el){
          var hkd = parseFloat(el.getAttribute('data-hkd')) || 0;
          var converted = hkd * rate;
          var symEl = el.querySelector('.cur-sym'), valEl = el.querySelector('.cur-val');
          if (symEl) symEl.textContent = sym;
          if (valEl) valEl.textContent = format(converted, cur);
        });
        localStorage.setItem('currency', cur);
      }
      apply(sel.value);
      sel.addEventListener('change', function(){ apply(sel.value); });
    })();

    // 工厂轮播
    (function(){
      var slides = document.querySelectorAll('#factorySlider .slide');
      var dots = document.querySelectorAll('.slider-dots span');
      if (!slides.length) return;
      var idx = 0;
      var delay = <%= (config && config.carousel_delay) ? (parseInt(config.carousel_delay,10)||4500) : 4500 %>;
      if (delay < 1500) delay = 4500;
      function show(i) {
        slides.forEach(function(s,j){ s.classList.toggle('active', j===i); });
        dots.forEach(function(d,j){ d.classList.toggle('active', j===i); });
        idx = i;
      }
      dots.forEach(function(d){ d.addEventListener('click', function(){ show(+d.getAttribute('data-index')); }); });
      if (slides.length > 1) setInterval(function(){ show((idx+1)%slides.length); }, delay);
    })();

    // 分类切换：AJAX 不整页刷新、不跳顶
    (function(){
      var sec = document.getElementById('products');
      var grid = document.querySelector('.product-grid');
      if (!sec || !grid) return;

      function applyBg(url) {
        if (!url) {
          sec.classList.remove('has-cat-bg');
          return;
        }
        sec.style.setProperty('--cat-bg', 'url('+url+')');
        sec.classList.add('has-bg', 'has-cat-bg');
      }

      function renderProducts(list) {
        if (!list || !list.length) {
          grid.innerHTML = '<div class="empty" style="grid-column:1/-1;">暂无产品</div>';
          return;
        }
        var lang = document.documentElement.getAttribute('lang') || 'zh-CN';
        var isEn = lang === 'en';
        grid.innerHTML = list.map(function(p){
          var img = p.image || (p.images ? String(p.images).split(',')[0] : '') || 'https://via.placeholder.com/400x400?text=No+Image';
          var name = isEn ? (p.name_en || p.name_zh || '') : (p.name_zh || p.name_en || '');
          var price = Number(p.price || 0).toFixed(2);
          return '<a href="/product/'+p.id+'" class="card">' +
            '<div class="card-img"><img src="'+img+'" alt="" loading="lazy" onerror="this.src=\'https://via.placeholder.com/400x400?text=No+Image\'"></div>' +
            '<div class="card-body"><h3>'+name+'</h3>' +
            '<div class="card-meta">OE: '+(p.oe||'-')+' · '+(p.model||'')+'</div>' +
            '<div class="price" data-hkd="'+(p.price||0)+'"><span class="cur-sym">HK$</span><span class="cur-val">'+price+'</span></div>' +
            '</div></a>';
        }).join('');
        // 重新应用货币
        var sel = document.getElementById('currencySelect');
        if (sel) sel.dispatchEvent(new Event('change'));
      }

      document.querySelectorAll('.cat-filter').forEach(function(a){
        a.addEventListener('click', function(e){
          e.preventDefault();
          var cat = this.getAttribute('data-cat') || '';
          var bg = this.getAttribute('data-bg') || '';
          document.querySelectorAll('.cat-filter').forEach(function(x){ x.classList.remove('active'); });
          this.classList.add('active');
          applyBg(bg);
          // 保持当前滚动，不跳顶
          var keepY = window.scrollY;
          var q = new URLSearchParams(window.location.search);
          var keyword = q.get('q') || '';
          var sort = q.get('sort') || 'date';
          var url = '/api/products?cat=' + encodeURIComponent(cat) + '&q=' + encodeURIComponent(keyword) + '&sort=' + encodeURIComponent(sort);
          fetch(url).then(function(r){ return r.json(); }).then(function(j){
            if (j.success) renderProducts(j.products);
            // 更新地址栏但不跳转
            var newUrl = cat ? ('/?cat=' + cat + (keyword ? '&q='+encodeURIComponent(keyword) : '') + '#products') : ('/' + (keyword ? '?q='+encodeURIComponent(keyword) : '') + '#products');
            history.pushState(null, '', newUrl);
            window.scrollTo(0, keepY);
          }).catch(function(){
            // 失败则正常跳转
            window.location.href = this.href;
          }.bind(this));
        });
      });

      var active = document.querySelector('.cat-filter.active[data-bg]');
      if (active && active.getAttribute('data-bg')) applyBg(active.getAttribute('data-bg'));
    })();

    // 回顶按钮
    (function(){
      var btn = document.getElementById('scrollTopBtn');
      if (!btn) return;
      window.addEventListener('scroll', function(){
        if (window.scrollY > 400) btn.classList.add('show');
        else btn.classList.remove('show');
      });
      btn.addEventListener('click', function(){
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();

    // 手机返回键
    (function(){
      var btn = document.getElementById('mobileBack');
      if (!btn) return;
      btn.addEventListener('click', function(){
        if (window.history.length > 1) history.back();
        else window.location.href = '/';
      });
    })();
  </script>
</body>
</html>
